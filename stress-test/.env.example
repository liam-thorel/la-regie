# Copie ce fichier en .env et remplis les valeurs.
# .env est ignoré par git (voir .gitignore) : rien de sensible ne part sur GitHub.

# Mêmes valeurs que src/environments/environment.ts
SUPABASE_URL=https://VOTRE-PROJET.supabase.co
SUPABASE_ANON_KEY=VOTRE_CLE_ANON_SUPABASE

# Combien de joueurs simuler et combien de manches jouer.
PLAYER_COUNT=10
ROUNDS_COUNT=3

# Domaine fictif utilisé pour les comptes de test (stress-test-<id>@ce-domaine).
# "Confirm email" doit être désactivé dans Supabase (Authentication > Sign In /
# Providers > Email), sinon ces comptes ne pourront jamais se connecter.
TEST_EMAIL_DOMAIN=stress.olygames.test
TEST_PASSWORD=StressTest123!

# Optionnel, uniquement pour cleanup.mjs si tu veux aussi supprimer les
# comptes de test (pas juste la partie). Clé "service_role" du projet
# (Settings > API) : elle contourne TOUTES les règles de sécurité, à ne
# jamais mettre ailleurs que dans ce .env local, jamais commitée, jamais
# utilisée côté navigateur.
# SUPABASE_SERVICE_ROLE_KEY=
